{
  "name": "amazon-teiki-canceler",
  "version": "1.1.0",
  "description": "Amazon定期おトク便を一括でキャンセル/スキップするCLI/デスクトップアプリ",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "teiki": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "login": "node src/index.js login",
    "list": "node src/index.js list",
    "cancel": "node src/index.js cancel",
    "skip": "node src/index.js skip",
    "manage": "node src/index.js manage",
    "inspect": "node src/index.js inspect",
    "test": "node test/run-tests.js",
    "mock": "node test/mock-amazon.js",
    "electron": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.1",
    "commander": "^12.1.0",
    "kleur": "^4.1.5",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.teiki-canceler.app",
    "productName": "定期おトク便かんたん解約",
    "files": [
      "!test/**",
      "!.profile/**",
      "!.profile-test/**",
      "!out/**",
      "!logs/**",
      "!error.log"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
