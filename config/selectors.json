        "waitAfter": 1200,
        "target": [
          {
            "role": "button",
            "name": "定期おトク便の設定を変更"
          },
          {
            "role": "link",
            "name": "定期おトク便の設定を変更"
          },
          {
            "text": "定期おトク便の設定を変更"
          },
          {
            "text": "設定を変更"
          },
          {
            "css": "a[href*='subscription' i][href*='edit' i]"
          },
          {
            "css": "[data-action*='expander' i] , .a-expander-prompt"
          }
        ]
      },
      {
        "description": "「定期おトク便をキャンセル」を押す",
        "scope": "cardThenPage",
        "action": "click",
        "optional": false,
        "waitAfter": 2000,
        "target": [
          {
            "role": "link",
            "name": "定期おトク便をキャンセル"
          },
          {
            "role": "button",
            "name": "定期おトク便をキャンセル"
          },
          {
            "text": "定期おトク便をキャンセル"
          },
          {
            "text": "この商品の定期おトク便をキャンセル"
          },
          {
            "text": "定期購入をキャンセル"
          },
          {
            "css": "a[href*='cancel' i]"
          },
          {
            "text": "キャンセル",
            "regex": true
          }
        ]
      },
      {
        "description": "キャンセル理由を選ぶ（あれば）",
