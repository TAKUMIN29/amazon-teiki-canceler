        "scope": "page",
        "action": "click",
        "optional": false,
        "waitAfter": 2500,
        "target": [
          {
            "role": "button",
            "name": "定期おトク便をキャンセル"
          },
          {
            "role": "button",
            "name": "キャンセルを確定"
          },
          {
            "role": "button",
            "name": "定期購入をキャンセル"
          },
          {
            "text": "定期おトク便をキャンセル"
          },
          {
            "text": "キャンセルを確定"
          },
          {
            "text": "はい、キャンセルします"
          },
          {
            "css": "input[type='submit'][value*='キャンセル' i]"
