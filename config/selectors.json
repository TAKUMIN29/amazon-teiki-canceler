{
  "_comment": [
    "Amazonの画面が変わったら、このファイルだけを直せば動くようになります。",
    "target は「候補の配列」です。上から順に試して、最初に見つかったものを使います。",
    "候補の書き方:",
    "  { \"css\": \"button.foo\" }",
    "  { \"text\": \"キャンセル\", \"tag\": \"button\" }   ... タグ省略可(*)",
    "  { \"role\": \"button\", \"name\": \"キャンセル\" }",
    "  { \"xpath\": \"//button[...]\" }",
    "  共通オプション: \"exact\": true / \"nth\": 0 / \"regex\": true"
  ],
  "urls": {
    "base": "https://www.amazon.co.jp",
    "subscriptions": "https://www.amazon.co.jp/auto-deliveries",
    "subscriptionsFallback": "https://www.amazon.co.jp/gp/subscribe-and-save/manager",
    "loginCheck": "https://www.amazon.co.jp/gp/css/homepage.html"
  },
  "auth": {
    "loggedOutMarkers": [
      {
        "css": "#ap_email"
      },
      {
        "css": "#ap_password"
      },
      {
        "css": "form[name='signIn']"
      },
      {
        "text": "Eメールまたは携帯電話番号"
      }
    ],
    "loggedInMarkers": [
      {
        "css": "#nav-link-accountList"
      },
      {
        "css": "#nav-your-amazon"
      }
    ],
    "challengeMarkers": [
      {
        "css": "form[action*='validateCaptcha' i]"
      },
      {
        "css": "#auth-mfa-otpcode"
      },
      {
        "text": "ロボットではないことを確認"
      },
      {
        "text": "Enter the characters you see below"
      }
    ]
  },
  "list": {
